# Copy this file to .env and fill in real values. Never commit .env.

# Free key from https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# Optional: requests per minute allowed per client on the public API (default 240).
# RATE_LIMIT_PER_MINUTE=240

# Optional: chat questions allowed per minute per client, counted apart from the map (default 20).
# CHAT_RATE_LIMIT_PER_MINUTE=20

# Optional: set to true only when the API sits behind a proxy that adds the real client address on
# the right of X-Forwarded-For (Render does). Then the rate limits count each visitor, not the proxy.
# Leave it off otherwise: a header a client can set must not decide who it is. Default false.
# TRUST_FORWARDED_FOR=false

# Optional: the websites allowed to call the API from another origin, comma separated, for example the
# public frontend: https://ap-143.github.io. Empty (default) sends no CORS headers.
# CORS_ALLOWED_ORIGINS=

# Optional: folder of reviewed .md documents the chat may quote (default backend/knowledge).
# KNOWLEDGE_DIR=

# Optional: file names of documents in the knowledge folder that a deployment must keep out, comma
# separated. The public site names the health texts here until a qualified person has reviewed them.
# KNOWLEDGE_EXCLUDE=kesehatan-kemenkes.md,kesehatan-who.md

# Optional: load the documents into the database on every start (default true). A serverless host starts
# often and several copies at once, so there it is false and only `load-knowledge` fills the table.
# KNOWLEDGE_RELOAD_ON_START=true

# Optional: a folder holding the embedding model as flat files (Vercel builds one at ./model). Empty
# uses the copy in the Docker image.
# EMBEDDING_MODEL_PATH=

# Optional: a language model for the chat. Leave LLM_BASE_URL empty to keep the chat on rules alone.
# Any server that speaks the OpenAI chat format works: a local Ollama (docker compose --profile ai),
# or a hosted free API such as Groq, OpenRouter or Cloudflare Workers AI. Never commit a real key.
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=20
# Limits on model calls for the whole application (not per visitor), kept below a free tier: past
# either one the chat answers from its rules alone and says it is in simple mode.
# LLM_CALLS_PER_MINUTE=20
# LLM_CALLS_PER_DAY=500
